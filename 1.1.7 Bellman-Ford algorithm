#include <stdio.h>
#include <stdlib.h>

#define INF 1000000000

typedef struct {
    int u, v, w;
} Edge;

// Function to print the path from source to target vertex
void printPath(int parent[], int v) {
    int path[1005];
    int count = 0;
    int curr = v;

    while (curr != -1) {
        path[count++] = curr;
        curr = parent[curr];
    }

    for (int i = count - 1; i >= 0; i--) {
        printf("%d", path[i]);
        if (i > 0) printf("->");
    }
}

